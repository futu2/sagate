# Public language functions. The double-underscore names are the small
# backend primitive layer used by the SQL compiler.
# Repeated operator definitions are an explicit finite overload set. Numeric
# operations intentionally keep int and float signatures separate.

# Backend primitive declarations. These names are implemented by the SQL
# compiler, not by sagate code; the declarations are the type-level source of
# truth. Relational primitives get their real typing from dedicated compiler
# rules, so their declarations only cover bare references.
__table : string -> string -> any;
__where : any -> any -> any;
__select : any -> any -> any;
__mapKey : any -> any -> any;
__mapValue : any -> any -> any;
__merge : any -> any -> any;
__agg : any -> any -> any;
__joinInner : any -> any -> any;
__joinLeft : any -> any -> any;
__joinRight : any -> any -> any;
__joinFull : any -> any -> any;
__order : any -> any -> any;
__limit : any -> any -> any;
__asc : a -> direction;
__desc : a -> direction;
__snake : keymapper;
__kebab : keymapper;
__camel : keymapper;
__prefix : string -> keymapper;
__suffix : string -> keymapper;
__maybe : valuemapper;
__list : valuemapper;
__add : int -> int -> int;
__add : float -> float -> float;
__sub : int -> int -> int;
__sub : float -> float -> float;
__mul : int -> int -> int;
__div : float -> float -> float;
__mod : int -> int -> int;
__eq : int -> int -> bool;
__eq : float -> float -> bool;
__eq : string -> string -> bool;
__eq : bool -> bool -> bool;
__eq : date -> date -> bool;
__eq : timestamp -> timestamp -> bool;
__ne : int -> int -> bool;
__ne : float -> float -> bool;
__ne : string -> string -> bool;
__ne : bool -> bool -> bool;
__ne : date -> date -> bool;
__ne : timestamp -> timestamp -> bool;
__lt : int -> int -> bool;
__lt : float -> float -> bool;
__lt : string -> string -> bool;
__lt : date -> date -> bool;
__lt : timestamp -> timestamp -> bool;
__le : int -> int -> bool;
__le : float -> float -> bool;
__le : string -> string -> bool;
__le : date -> date -> bool;
__le : timestamp -> timestamp -> bool;
__gt : int -> int -> bool;
__gt : float -> float -> bool;
__gt : string -> string -> bool;
__gt : date -> date -> bool;
__gt : timestamp -> timestamp -> bool;
__ge : int -> int -> bool;
__ge : float -> float -> bool;
__ge : string -> string -> bool;
__ge : date -> date -> bool;
__ge : timestamp -> timestamp -> bool;
__and : bool -> bool -> bool;
__or : bool -> bool -> bool;
__count : a -> agg int;
__sum : a -> agg a;
__avg : a -> agg float;
__min : a -> agg a;
__max : a -> agg a;
__group : a -> group a;

table : string -> string -> query r = schemaName => tableName => __table schemaName tableName

_+_ : int -> int -> int = left => right => __add left right
_+_ : float -> float -> float = left => right => __add left right
_-_ : int -> int -> int = left => right => __sub left right
_-_ : float -> float -> float = left => right => __sub left right
_*_ : int -> int -> int = left => right => __mul left right
_/_ : float -> float -> float = left => right => __div left right
_%_ : int -> int -> int = left => right => __mod left right
_==_ : int -> int -> bool = left => right => __eq left right
_==_ : float -> float -> bool = left => right => __eq left right
_==_ : string -> string -> bool = left => right => __eq left right
_==_ : bool -> bool -> bool = left => right => __eq left right
_==_ : date -> date -> bool = left => right => __eq left right
_==_ : timestamp -> timestamp -> bool = left => right => __eq left right
_!=_ : int -> int -> bool = left => right => __ne left right
_!=_ : float -> float -> bool = left => right => __ne left right
_!=_ : string -> string -> bool = left => right => __ne left right
_!=_ : bool -> bool -> bool = left => right => __ne left right
_!=_ : date -> date -> bool = left => right => __ne left right
_!=_ : timestamp -> timestamp -> bool = left => right => __ne left right
_<_ : int -> int -> bool = left => right => __lt left right
_<_ : float -> float -> bool = left => right => __lt left right
_<_ : string -> string -> bool = left => right => __lt left right
_<_ : date -> date -> bool = left => right => __lt left right
_<_ : timestamp -> timestamp -> bool = left => right => __lt left right
_<=_ : int -> int -> bool = left => right => __le left right
_<=_ : float -> float -> bool = left => right => __le left right
_<=_ : string -> string -> bool = left => right => __le left right
_<=_ : date -> date -> bool = left => right => __le left right
_<=_ : timestamp -> timestamp -> bool = left => right => __le left right
_>_ : int -> int -> bool = left => right => __gt left right
_>_ : float -> float -> bool = left => right => __gt left right
_>_ : string -> string -> bool = left => right => __gt left right
_>_ : date -> date -> bool = left => right => __gt left right
_>_ : timestamp -> timestamp -> bool = left => right => __gt left right
_>=_ : int -> int -> bool = left => right => __ge left right
_>=_ : float -> float -> bool = left => right => __ge left right
_>=_ : string -> string -> bool = left => right => __ge left right
_>=_ : date -> date -> bool = left => right => __ge left right
_>=_ : timestamp -> timestamp -> bool = left => right => __ge left right
_&&_ : bool -> bool -> bool = left => right => __and left right
_||_ : bool -> bool -> bool = left => right => __or left right

_&_ = value => function => function value
_$_ = function => value => function value
_>>>_ = first => second => value => second (first value)
_<<<_ = second => first => value => second (first value)

where : (row r -> bool) -> query r -> query r = predicate => relation => __where predicate relation
select : (row r -> row s) -> query r -> query s = projection => relation => __select projection relation
mapKey : keymapper m -> query r -> query (mapkey m r) = mapper => relation => __mapKey mapper relation
mapValue : valuemapper m -> query r -> query (mapvalue m r) = mapper => relation => __mapValue mapper relation
merge : query r -> query s -> query (merge r s) = older => newer => __merge older newer
agg : (row r -> row s) -> query r -> query s = projection => relation => __agg projection relation
inner = right_relation => predicate => left_relation => __joinInner right_relation predicate left_relation
left = right_relation => predicate => left_relation => __joinLeft right_relation predicate left_relation
right = right_relation => predicate => left_relation => __joinRight right_relation predicate left_relation
full = right_relation => predicate => left_relation => __joinFull right_relation predicate left_relation

# Sort keys tag each key value with its direction; the key function maps a
# row to that tagged list.
asc : a -> direction = value => __asc value
desc : a -> direction = value => __desc value
order : (row r -> list direction) -> query r -> query r = keys => relation => __order keys relation
limit : int -> query r -> query r = n => relation => __limit n relation

group : a -> group a = field => __group field
count : a -> agg int = field => __count field
sum : a -> agg a = field => __sum field
avg : a -> agg float = field => __avg field
min : a -> agg a = field => __min field
max : a -> agg a = field => __max field

id : a -> a = x => x
identity : a -> a = x => x
snake : keymapper = __snake
kebab : keymapper = __kebab
camel : keymapper = __camel
prefix : string -> keymapper = value => __prefix value
suffix : string -> keymapper = value => __suffix value
maybe : valuemapper = __maybe
list : valuemapper = __list
